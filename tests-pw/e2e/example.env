# Copy to .env in this folder (tests-pw/e2e/.env) for local overrides.
# .env is gitignored. Never commit real values or API keys.
# Every variable is optional: with none set, `npm run e2e` builds the app,
# serves it on port 3100 and runs the suite in local Chromium.

# --- Target ---
# Site profile key (default: novera).
BLAZE_TEST_PLAYWRIGHT_SITE=
# Point at a deployed site instead of the local production build. When set,
# the local web server is not started.
BLAZE_TEST_PLAYWRIGHT_BASE_URL=
# JSON file of locator overrides deep-merged over the profile at runtime.
BLAZE_TEST_PLAYWRIGHT_LOCATOR_OVERRIDES=

# --- Staging access (unused by Novera) ---
BLAZE_TEST_HTTP_CREDENTIALS_USERNAME=
BLAZE_TEST_HTTP_CREDENTIALS_PASSWORD=
BLAZE_X_CLIENT=

# --- Test user (unused: Novera has no login; auth specs skip) ---
BLAZE_TEST_PLAYWRIGHT_USER_EMAIL=
BLAZE_TEST_PLAYWRIGHT_USER_PASSWORD=
BLAZE_TEST_PLAYWRIGHT_ALLOW_REGISTRATION=

# --- Run shape ---
BLAZE_TEST_PLAYWRIGHT_WORKERS=
BLAZE_TEST_PLAYWRIGHT_RETRIES=
# chromium (default) | core | desktop | mobile | all
BLAZE_TEST_PLAYWRIGHT_PLATFORM_COVERAGE=
# Results file for blaze-e2e-triage (default: test-results/e2e-results.json).
BLAZE_TEST_RESULTS_FILE=

# --- BrowserStack: OFF for this project ---
# The npm scripts force BLAZE_TEST_BROWSERSTACK=false. Leave the credentials empty.
BLAZE_TEST_BROWSERSTACK=false
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
BLAZE_TEST_BROWSERSTACK_PLATFORMS=
BLAZE_TEST_BROWSERSTACK_PARALLELS=
BLAZE_TEST_BROWSERSTACK_PROJECT=
BLAZE_TEST_BROWSERSTACK_BUILD=
BLAZE_TEST_BROWSERSTACK_LOCAL=
BROWSERSTACK_LOCAL_IDENTIFIER=
BLAZE_TEST_BROWSERSTACK_DEBUG=
# Optional BrowserStack build tags: CUSTOM_TAG_1, CUSTOM_TAG_2, ...

# --- Failure triage (npx blaze-e2e-triage) ---
# Without a key it prints a plain list of failures. --dry-run never calls out.
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
BLAZE_TRIAGE_MODEL=
SLACK_WEBHOOK_URL=
